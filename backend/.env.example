PORT=10000
FRONTEND_ORIGIN=https://YOUR-FRONTEND.onrender.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFY_EMAIL=your_email@gmail.com

ADMIN_KEY=generate-a-long-random-secret

# Código de recarga Tmcel que aparece na "caixa de surpresa" do site,
# só depois de ela abrir a caixa 2 vezes. Depois da 2ª abertura o código
# é apagado da memória do servidor (não fica gravado em lado nenhum).
TMCEL_CODE=coloca-aqui-o-codigo-real

# Controla se essa 2ª abertura apaga o código para sempre.
# false → modo de desenvolvimento: podes abrir a caixa à vontade sem
#         perderes o código, útil enquanto estás a testar o site.
# true  → modo real: usa isto quando fores mandar o link para ela.
BOX_ERASE_ENABLED=false
